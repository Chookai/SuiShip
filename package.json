{
  "name": "suiship",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "start:prod": "concurrently -k -n app,ais \"next start\" \"PORT=8081 node tools/mock-ais/server.mjs\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:docs": "tsx scripts/generate-memory-demo-docs.ts",
    "market:page": "node scripts/show-market-page.mjs",
    "memwal:setup": "tsx scripts/create-memwal-account-and-seed.ts",
    "memwal:fresh": "tsx scripts/create-memwal-account-and-seed.ts --seed-parties",
    "memwal:empty": "tsx scripts/create-memwal-account-and-seed.ts --no-seed",
    "seed:pause-issue": "tsx scripts/seed-persistent-agent-issue.ts",
    "slush:setup": "tsx scripts/setup-party-slush-accounts.ts",
    "slush:fund": "tsx scripts/fund-party-slush-accounts.ts",
    "verify:seal-demo": "tsx scripts/verify-seal-demo.ts",
    "ais:stub": "node tools/mock-ais/server.mjs",
    "test:e2e": "playwright test --headed",
    "test:e2e:debug": "playwright test --headed --debug",
    "test:e2e:ci": "playwright test --headless"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@mysten-incubation/memwal": "^0.0.4",
    "@mysten/dapp-kit": "^1.0.6",
    "@mysten/seal": "^1.1.3",
    "@mysten/sui": "^2.16.2",
    "@tanstack/react-query": "^5.62.8",
    "better-sqlite3": "^12.10.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "framer-motion": "^12.40.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "p-limit": "^6.2.0",
    "pino": "^9.6.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "uuid": "^14.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
