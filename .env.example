# ── Anthropic (existing) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Mock document AI (set to false to use real Haiku extraction)
MOCK_DOC_AI=true
MOCK_DOC_PASS=true

# ── SQLite ────────────────────────────────────────────────────────────────────
# Path to the SQLite database file. Defaults to ./data/suiship.db
SQLITE_DB_PATH=./data/suiship.db

# ── Walrus ────────────────────────────────────────────────────────────────────
# Epoch duration at mint time (24 = ~24 days on testnet). Testnet WAL is free via faucet.
# Use 5 for cheaper testnet dev; 24+ for production-grade durability.
WALRUS_EPOCHS=24

# ── MemWal ────────────────────────────────────────────────────────────────────
# SDK: npm install @mysten-incubation/memwal
# Get key + accountId from https://app.memwal.com after creating a MemWalAccount on Sui.
# If not set, mint uses a mock space ID (manifest still cached in SQLite).
#
# Ed25519 delegate private key (hex) — generated and registered on your MemWalAccount.
MEMWAL_ED25519_KEY=your-ed25519-private-key-hex
# Sui object ID of your MemWalAccount (on-chain object).
MEMWAL_ACCOUNT_ID=0xTODO_YOUR_MEMWAL_ACCOUNT_ID
# Testnet relayer (default for staging). Production relayer: https://relayer.memwal.ai
MEMWAL_SERVER_URL=https://relayer.staging.memwal.ai

# ── Sui Client ────────────────────────────────────────────────────────────────
# "mock" uses MockSuiPassportClient (SQLite-backed, 200-500ms simulated latency).
# "real" uses RealSuiPassportClient (requires Move contract deployed + package ID set).
SUI_CLIENT=mock

# Error rate for mock Sui client chaos testing (0.0 = never fail, 1.0 = always fail).
MOCK_SUI_ERROR_RATE=0

# ── Sui Blockchain (existing) ──────────────────────────────────────────────────
# Deployed Move package address. Set to real address when teammate deploys contract.
# See SUI_CONTRACT_SPEC.md for what the contract must implement.
NEXT_PUBLIC_SUISHIP_PACKAGE_ID=0xTODO_PUBLISH_PACKAGE
