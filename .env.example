# ── Anthropic (existing) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Mock document AI (set to false to use real Haiku extraction)
MOCK_DOC_AI=true
MOCK_DOC_PASS=true

# ── SQLite ────────────────────────────────────────────────────────────────────
# Path to the SQLite database file. Defaults to ./data/suiship.db
SQLITE_DB_PATH=./data/suiship.db

# ── Walrus ────────────────────────────────────────────────────────────────────
# Epoch duration at mint time (24 = ~24 days on testnet). Testnet WAL is free via faucet.
# Use 5 for cheaper testnet dev; 24+ for production-grade durability.
WALRUS_EPOCHS=24

# ── MemWal ────────────────────────────────────────────────────────────────────
# Master switch: false = no MemWal reads/writes (manifest cached in SQLite only).
ENABLE_MEMWAL=true
# SDK: npm install @mysten-incubation/memwal
# Get key + accountId from https://app.memwal.com after creating a MemWalAccount on Sui.
# If not set, mint uses a mock space ID (manifest still cached in SQLite).
#
# Ed25519 delegate private key (hex) — generated and registered on your MemWalAccount.
MEMWAL_ED25519_KEY=your-ed25519-private-key-hex
# Sui object ID of your MemWalAccount (on-chain object).
MEMWAL_ACCOUNT_ID=0xTODO_YOUR_MEMWAL_ACCOUNT_ID
# Testnet relayer (default for staging). Production relayer: https://relayer.memwal.ai
MEMWAL_SERVER_URL=https://relayer.staging.memwal.ai
# MemWal Move package ID (used by setup scripts, not the main app).
MEMWAL_PACKAGE_ID=0xTODO_MEMWAL_PACKAGE_ID
# MemWal registry object ID (used by mint-sequence and setup scripts).
MEMWAL_REGISTRY_ID=0xTODO_MEMWAL_REGISTRY_ID
# Client-side MemWal registry ID (same value as MEMWAL_REGISTRY_ID).
NEXT_PUBLIC_REGISTRY_ID=0xTODO_MEMWAL_REGISTRY_ID

# ── Sui Client ────────────────────────────────────────────────────────────────
# "mock" uses MockSuiPassportClient (SQLite-backed, 200-500ms simulated latency).
# "real" uses RealSuiPassportClient (requires Move contract deployed + package ID set).
SUI_CLIENT=mock

# Error rate for mock Sui client chaos testing (0.0 = never fail, 1.0 = always fail).
MOCK_SUI_ERROR_RATE=0

# ── Sui Blockchain ────────────────────────────────────────────────────────────
# Deployed Move package address on Sui testnet.
# Already deployed — use this ID, or redeploy and paste your own.
NEXT_PUBLIC_SUISHIP_PACKAGE_ID=0xb64a35301e1703cee52e4712286c5438e8598b2e02290c4c3cc911db78cf33e9

# Sui network to connect to ("testnet" | "mainnet" | "devnet").
SUI_NETWORK=testnet

# Server-side Sui private key used for endorsement signing (suiprivkey... format).
# Only required when SUI_CLIENT=real and you want server-side endorsements.
# Generate with: sui client new-address ed25519
SUI_PRIVATE_KEY=suiprivkey...

# Demo requester key used for Tier 0 SEAL verification and the judge-facing provenance panel.
# This is a testnet-only key with no real funds. A judge-facing demo key for on-chain provenance.
DEMO_KEYPAIR_HEX=suiprivkey...
NEXT_PUBLIC_DEMO_KEYPAIR_HEX=suiprivkey...

# ── Sui SEAL (experimental) ───────────────────────────────────────────────────
# Sui SEAL is an experimental threshold encryption layer. Leave unset to skip SEAL features.
SEAL_ENABLED=true
# JSON array of key server configs, e.g. [{"objectId":"0x...","weight":1}]
SEAL_KEY_SERVER_CONFIGS=

# Scenario C party wallets (Acme exporter, Shanghai importer, Freight Forwarder).
# Generate + fund with: npm run slush:setup
SUI_SLUSH_EXPORTER_KEY=suiprivkey...
SUI_SLUSH_IMPORTER_KEY=suiprivkey...
SUI_SLUSH_FREIGHT_FORWARDER_KEY=suiprivkey...
# When true, Custody Chain signs endorsements server-side for the selected mock role.
ENABLE_PARTY_SLUSH_SIGNING=true

# ── Agentic Chatbot ────────────────────────────────────────────────────────────
# Set both to "true" to enable the tool-calling agent mode in the shipment chatbot.
# When unset, the chatbot falls back to the original plain-context mode.
CHAT_AGENT_MODE=true
NEXT_PUBLIC_CHAT_AGENT_MODE=true

# ── Chat role gating ──────────────────────────────────────────────────────────
# When true, chatbot access is gated by the endorsement chain.
# Exporter: always full. FF: unlocks after picked_up. Importer: unlocks after cleared_customs.
CHAT_ROLE_GATING=true
NEXT_PUBLIC_CHAT_ROLE_GATING=true

# Field-level redaction in chat (strict = default, permissive = demo full-disclosure, off = disable)
CHAT_REDACTION_MODE=strict
NEXT_PUBLIC_CHAT_REDACTION_MODE=strict

# ── Risk Agent ────────────────────────────────────────────────────────────────
# Optional: enables live public news search in risk scans.
# Without this key, risk scans use MemWal historical data only.
SERPAPI_API_KEY=your-serpapi-key

# ── AIS Simulation Server ─────────────────────────────────────────────────────
# Base URL for the AIS simulation server (mock or real vessel tracking).
# Defaults to http://localhost:8081 when unset (local dev with the mock server).
AIS_BASE_URL=http://localhost:8081
